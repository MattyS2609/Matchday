# Use "demo" for local sample data or "api-football" for the server-side provider.
VITE_DATA_MODE=api-football

# Never expose this key through a VITE_ variable or commit it to this file.
# Put the real value in a local .env file instead.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_LEAGUE_ID=39
# The free plan currently accepts 2022, 2023, or 2024.
API_FOOTBALL_SEASON=2024

# Match Story generation. Keep deterministic until Bedrock access is configured.
MATCH_QUESTION_MODE=deterministic
MATCH_QUESTION_FALLBACK=true
AWS_REGION=eu-west-2
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
